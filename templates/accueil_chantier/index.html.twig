{% extends 'base.html.twig' %}

{% block title %}Le chantier de la Dalle Robespierre{% endblock %}

{% block body %}
    <div class="py-24 items-center text-center justify-center">
        <h1 class="text-4xl font-bold mb-8">Le chantier de la Dalle Robespierre</h1>
        <div class="relative w-full h-[300px] md:h-[500px]">
    <!-- Image -->
    <img 
        src="{{ asset('assets/img/chantierExample2-removebg-preview.png') }}" 
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
