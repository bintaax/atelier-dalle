  <a 
  href="{{ path('app_co_habiter') }}"
  class="absolute bottom-[60px] left-1/2 -translate-x-1/2
         bg-teal-400 text-white rounded px-4 py-2 z-10 
         shadow-lg hover:bg-teal-900 transition"
>
  Co-habiter avec le chantier
</a>

</div>

    </div>
